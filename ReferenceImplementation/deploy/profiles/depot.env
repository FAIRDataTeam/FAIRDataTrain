# The Train Depot — the authority for a train (ADR-029).
#
# A registry says a train exists and where it was harvested from. This says what it *is*: the
# concrete class, the mechanism, the parameters, the input requirement, and the payload digest
# a station checks at PEP 1 and a controller's approval is bound to. The Handler console's H1
# resolves every train here rather than trusting the index.

FDT_DEPOT_IRI=https://depot.example.org/fdt/v1
FDT_DEPOT_TITLE=FDT Community Depot (fictional)

# The port this instance is served on. Here rather than in the runner so that it cannot
# drift from the base_url above, which is what the component publishes about itself.
FDT_TESTBED_PORT=8402

# Browser origins allowed to read this component — what CORS calls the allowed origins.
#
# A console is a separate deployment from the component it looks at, and the Handler's console
# reads a Handler, a registry and a Depot on one page, so it can never be same-origin with all
# of them. Without this a browser refuses every request the console makes and the console
# reports that the component did not answer — which is exactly what it looks like from inside
# the page, and is how this was found.
#
# Two origins because there are two ways to run this testbed: the consoles' own container
# (`make up`) and `npm run dev` on the host (`make up-processes`). Nothing is allowed by
# default; naming them is a deliberate act of configuration (Q23).
FDT_DEPOT_CORS_ORIGINS=http://localhost:8405,http://localhost:5173

# ── Its write surface (ADR-036, protocol/train-publication.md) ───────────────────────────────
#
# A Depot without a store publishes a curated corpus and accepts neither a publication nor a
# withdrawal — it answers 501 and says so, rather than taking a submission into memory and
# losing it at the next restart. A withdrawal that a reboot undoes is a takedown that comes
# back, which is the one failure a takedown cannot have.
#
# `.testbed/` is runtime state, and it resolves to the checkout on a developer's machine and to
# a directory inside the container under `make up`. Compose declares no volume, so this testbed
# is still clean after `make down && make up`.
FDT_DEPOT_STORE=.testbed/depot-store

# Who operates this Depot. A withdrawal made with the credential below is recorded as this
# party's, and the record has to say who: "the author says this code is wrong" and "this host
# has stopped carrying it" are different news for a consumer holding results, and a withdrawal
# by nobody has collapsed them (ADR-036 §4).
FDT_DEPOT_OPERATOR=https://example.org/fdt/party/fdt-community-depot

# The credential this Depot was configured with, out of band. It authorises exactly one thing:
# withdrawing a train this Depot has been compelled or has chosen to stop carrying. It says
# nothing about who created a train or who may take one (ADR-035).
#
# A testbed credential in a file in the repository, like every other credential here. Nothing in
# this testbed is a secret and nothing in it is real.
FDT_DEPOT_ADMIN_TOKEN=fdt-testbed-depot-operator

# Publishing is NOT configured, and that is visible rather than hidden. A Depot resolves a
# creator's keys from its own configuration and never from the submission — a key fetched from
# wherever the submitter pointed would prove only that they hold the key they nominated — so
# without FDT_DEPOT_CREATOR_KEYS this Depot has been told about nobody and refuses every
# signature as an unknown key. Set it to a JSON document mapping a creator IRI to that creator's
# JWK Set to let a train be published here.
# FDT_DEPOT_CREATOR_KEYS=.testbed/creator-keys.json
