# Oosterlicht MC station (clinical genetics, fictional) — the other half of the pair.
#
# It is in two networks, and they differ on the one thing that matters here: the national health
# research network permits a machine to conclude a negotiation, and the regional stroke network
# **Oost does not**. In Oost this station therefore decides nothing in either direction
# (ADR-032) — not even a refusal, because an automated refusal is an adverse decision taken by a
# machine too. It evaluates, recommends, and puts the case to a person.
#
# That is what puts anything in console S3, and what makes the decision-mode selector in S8
# show `HumanRequiredByRegulation` against one network and the operator's own choice against the
# other. A testbed with only the UT station would show the automated path and imply it was the
# only one.
#
# Two memberships and two offers over one dataset is ADR-017 in a fixture: conditions are
# evaluated per network, and a dataset offered in one network is not thereby offered in another.

FDT_STATION_IRI=https://example.org/fdt/station/oosterlicht
FDT_STATION_TITLE=Oosterlicht MC station (clinical genetics, fictional)
FDT_STATION_OWNER_NAME=Oosterlicht MC — clinical genetics IT
FDT_STATION_BASE_URL=http://localhost:8401
FDT_STATION_CATALOG_IRI=https://example.org/fdt/catalog/oosterlicht
FDT_STATION_ADAPTERS=["sparql"]

FDT_STATION_RUN_MODE=development
FDT_STATION_DECISION_MODE=automated
FDT_STATION_ADMIN_TOKEN=testbed-operator
FDT_STATION_AUTH_REQUIRED=false


FDT_STATION_MEMBERSHIPS=[{"network":"https://example.org/fdt/net/stroke-oost","network_title":"Stroke network Oost (regional acute-care network)","governance_authority":"https://example.org/fdt/auth/roaz-oost","governance_authority_name":"Governance authority","admits_natural_persons":false,"permits_automated_decision":false,"trusted_issuer":"https://idp.example.org/surfconext-like","role":"https://w3id.org/fdt/network#StationRole","credential":"https://example.org/fdt/net/stroke-oost/credential"},{"network":"https://example.org/fdt/net/health-research-nl","network_title":"National health research network","governance_authority":"https://example.org/fdt/auth/hri-like","governance_authority_name":"Governance authority","admits_natural_persons":false,"permits_automated_decision":true,"trusted_issuer":"https://idp.example.org/ls-aai-like","role":"https://w3id.org/fdt/network#StationRole","credential":"https://example.org/fdt/net/health-research-nl/credential"}]

FDT_STATION_DATASETS=[{"iri":"https://example.org/fdt/dataset/oosterlicht-gene-disease","adapter":"sparql","source":"fdt-commons/examples/data/ut-gene-disease.ttl"}]

# The port this instance is served on. Here rather than in the runner so that it cannot
# drift from the base_url above, which is what the component publishes about itself.
FDT_TESTBED_PORT=8401

# Browser origins allowed to read this component — what CORS calls the allowed origins.
#
# A console is a separate deployment from the component it looks at, and the Handler's console
# reads a Handler, a registry and a Depot on one page, so it can never be same-origin with all
# of them. Without this a browser refuses every request the console makes and the console
# reports that the component did not answer — which is exactly what it looks like from inside
# the page, and is how this was found.
#
# Two origins because there are two ways to run this testbed: the consoles' own container
# (`make up`) and `npm run dev` on the host (`make up-processes`). Nothing is allowed by
# default; naming them is a deliberate act of configuration (Q23).
FDT_STATION_CORS_ORIGINS=http://localhost:8405,http://localhost:5173

# ── The controller's own surface (ADR-011, finding 73) ──────────────────────────────────────
#
# Whose data somebody speaks for. Not the visit's token, which says who is visiting on behalf of
# which consumer, and not the admin token, which says who may configure the station: three
# questions about three parties, three credentials. Console S3 (approvals) and S4 (access
# conditions) both send this one.
FDT_STATION_CONTROLLER_TOKENS={"testbed-controller":"https://example.org/fdt/party/oosterlicht-genetics"}

# Where a controller's access conditions are kept. Without it this station publishes the
# conditions it was deployed with and answers 501 to a change, saying so — because a condition
# written into memory is a governance decision the controller was told had taken effect and that
# the next restart undoes, silently widening their terms back.
#
# `.testbed/` is runtime state: the checkout on a developer's machine, a directory inside the
# container under `make up`. Compose declares no volume, so `make down && make up` is still clean.
FDT_STATION_CONDITIONS_DIR=.testbed/station-oosterlicht-conditions

# ── Signing the agreements this station concludes (ADR-038) ─────────────────────────────────
#
# Both parties sign. This station signs the ASSIGNER's side — as the data controller's agent,
# because no controller here holds a key of their own, and the agreement says so rather than
# letting the station's signature read as the controller's. Without a key it concludes nothing
# and says so at startup, which is honest and is not a testbed.
#
# `FDT_STATION_PARTY_KEYS` is the other half: the PUBLIC key of the train owner whose Handler
# signs the assignee's side. Out of band, on purpose — a station that fetched the key from
# wherever the signature pointed would establish only that the signer holds the key they
# nominated, which is no statement about who agreed.
#
# Both are derived by `deploy/agreement_keys.py` rather than committed: a key derived from a
# constant in a public repository is a key everybody has, which is fine for a testbed where
# nothing is a secret and nothing is real, and is wrong everywhere else.
FDT_STATION_SIGNING_KEY=.testbed/station-oosterlicht-signing-key.json
FDT_STATION_PARTY_KEYS=.testbed/agreement-party-keys.json
