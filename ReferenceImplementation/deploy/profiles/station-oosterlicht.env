# Oosterlicht MC station (clinical genetics, fictional) — the other half of the pair.
#
# It is in two networks, and they differ on the one thing that matters here: the national health
# research network permits a machine to conclude a negotiation, and the regional stroke network
# **Oost does not**. In Oost this station therefore decides nothing in either direction
# (ADR-032) — not even a refusal, because an automated refusal is an adverse decision taken by a
# machine too. It evaluates, recommends, and puts the case to a person.
#
# That is what puts anything in console S3, and what makes the decision-mode selector in S8
# show `HumanRequiredByRegulation` against one network and the operator's own choice against the
# other. A testbed with only the UT station would show the automated path and imply it was the
# only one.
#
# Two memberships and two offers over one dataset is ADR-017 in a fixture: conditions are
# evaluated per network, and a dataset offered in one network is not thereby offered in another.

FDT_STATION_IRI=https://example.org/fdt/station/oosterlicht
FDT_STATION_TITLE=Oosterlicht MC station (clinical genetics, fictional)
FDT_STATION_OWNER_NAME=Oosterlicht MC — clinical genetics IT
FDT_STATION_BASE_URL=http://localhost:8401
FDT_STATION_CATALOG_IRI=https://example.org/fdt/catalog/oosterlicht
FDT_STATION_ADAPTERS=["sparql"]

FDT_STATION_RUN_MODE=development
FDT_STATION_DECISION_MODE=automated
FDT_STATION_ADMIN_TOKEN=testbed-operator
FDT_STATION_AUTH_REQUIRED=false

# Q21's placeholder again, for the other party. A visit's token says who is visiting on behalf
# of which consumer; the admin token says who may configure the station; this says whose data
# somebody speaks for. Three questions, three credentials (ADR-011) — console S3 sends this one.
FDT_STATION_CONTROLLER_TOKENS={"testbed-controller":"https://example.org/fdt/party/oosterlicht-genetics"}

FDT_STATION_MEMBERSHIPS=[{"network":"https://example.org/fdt/net/stroke-oost","network_title":"Stroke network Oost (regional acute-care network)","governance_authority":"https://example.org/fdt/auth/roaz-oost","governance_authority_name":"Governance authority","admits_natural_persons":false,"permits_automated_decision":false,"trusted_issuer":"https://idp.example.org/surfconext-like","role":"https://w3id.org/fdt/network#StationRole","credential":"https://example.org/fdt/net/stroke-oost/credential"},{"network":"https://example.org/fdt/net/health-research-nl","network_title":"National health research network","governance_authority":"https://example.org/fdt/auth/hri-like","governance_authority_name":"Governance authority","admits_natural_persons":false,"permits_automated_decision":true,"trusted_issuer":"https://idp.example.org/ls-aai-like","role":"https://w3id.org/fdt/network#StationRole","credential":"https://example.org/fdt/net/health-research-nl/credential"}]

FDT_STATION_DATASETS=[{"iri":"https://example.org/fdt/dataset/oosterlicht-gene-disease","adapter":"sparql","source":"fdt-commons/examples/data/ut-gene-disease.ttl"}]

# The port this instance is served on. Here rather than in the runner so that it cannot
# drift from the base_url above, which is what the component publishes about itself.
FDT_TESTBED_PORT=8401
