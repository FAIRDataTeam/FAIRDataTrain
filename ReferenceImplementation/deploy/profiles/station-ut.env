# The University station (fictional) — the station the M1 scenario visits.
#
# Its network permits automated decisions and the operator has chosen `automated`, so a request
# whose every condition is met is granted without anybody being asked. That is what makes the
# M1 run finish in a browser while you watch it, and it is one half of the pair: see
# station-noorderlicht.env for a station in a network where a machine may not decide at all.
#
# Paths are relative to ReferenceImplementation/ — deploy/testbed.py resolves them.

FDT_STATION_IRI=https://example.org/fdt/station/ut
FDT_STATION_TITLE=University station (fictional)
FDT_STATION_OWNER_NAME=University — ICT services
FDT_STATION_BASE_URL=http://localhost:8400
FDT_STATION_CATALOG_IRI=https://example.org/fdt/catalog/ut
FDT_STATION_ADAPTERS=["sparql"]

# ADR-034. Stated rather than defaulted: a testbed that relied on the default would be
# demonstrating the default, and `production` defaults to sending everything to a person.
FDT_STATION_RUN_MODE=development
FDT_STATION_DECISION_MODE=automated

# Q21's placeholder. The operator surface — the visit list, the audit slice — is other parties'
# traffic and is not served without this. Console S1 and S7 ask for it.
FDT_STATION_ADMIN_TOKEN=testbed-operator

# A visit carries no token here and the station is told so explicitly, because turning
# authentication off is a visible act of configuration and never a default: a station that
# accepted anonymous visits by accident could not say who ran a train against its data.
FDT_STATION_AUTH_REQUIRED=false

FDT_STATION_MEMBERSHIPS=[{"network":"https://example.org/fdt/net/health-research-nl","network_title":"National health research network","governance_authority":"https://example.org/fdt/auth/hri-like","governance_authority_name":"Governance authority","admits_natural_persons":false,"permits_automated_decision":true,"trusted_issuer":"https://idp.example.org/ls-aai-like","role":"https://w3id.org/fdt/network#StationRole","credential":"https://example.org/fdt/cred/ut"}]

FDT_STATION_DATASETS=[{"iri":"https://example.org/fdt/dataset/ut-gene-disease","adapter":"sparql","source":"fdt-commons/examples/data/ut-gene-disease.ttl"}]

# The port this instance is served on. Here rather than in the runner so that it cannot
# drift from the base_url above, which is what the component publishes about itself.
FDT_TESTBED_PORT=8400
