# The metadata registry — an index, and explicitly not a trust anchor (ADR-029).
#
# It harvests both stations and the Depot. Both matter: a registry that harvested only stations
# would know what data exists and nothing about what any train needs, so it could answer no
# search at all — a train's input requirement is read from what its Depot published.
#
# Sources are `kind=url` per comma.

FDT_REGISTRY_IRI=https://registry.example/fdt/v1
FDT_REGISTRY_TITLE=FDT testbed registry
FDT_REGISTRY_BASE_URL=http://localhost:8403
FDT_REGISTRY_SOURCES=station=http://localhost:8400,station=http://localhost:8401,depot=http://localhost:8402

# The port this instance is served on. Here rather than in the runner so that it cannot
# drift from the base_url above, which is what the component publishes about itself.
FDT_TESTBED_PORT=8403
