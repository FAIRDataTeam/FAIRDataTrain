# The consoles, as the container image serves them (`deploy/docker/Dockerfile.console`).
#
# Only a port. The consoles are static bundles and hold no configuration: which station, Depot,
# registry or Handler a console talks to is a query parameter on the URL, because one build is
# opened against whichever instance a person is looking at. `deploy/docker/console-index.html`
# is the page that carries those parameters for this testbed.
#
# Not used by `make up-processes`, where the consoles are `npm run dev` on the host — the short
# loop between an edit and the screen, which a container build stands in the middle of.

FDT_TESTBED_PORT=8405
