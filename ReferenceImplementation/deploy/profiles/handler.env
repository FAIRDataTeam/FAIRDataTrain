# The Train Handler — the data consumer's side, driving the M1 plan on startup.
#
# It has no settings class of its own: a Handler is configured by the plan it is given and the
# arguments it is dispatched with. This profile is therefore read by `deploy/testbed.py` rather
# than by the component, and it holds only what the testbed decides — which plan, on whose
# behalf, under which IRI, on which port. Where the stations actually are is NOT here: that
# comes from `station-ut.env`, so the address the Handler dispatches to and the address the
# station publishes cannot disagree.

FDT_HANDLER_IRI=https://handler.cardionet.example/fdt/v1

# The person on whose behalf the run is made — fictional, like every party in this testbed.
FDT_HANDLER_AGENT=m.devries@cardionet.example

# The plan the M1 scenario runs, and the one WP-5.5's acceptance criterion names. Relative to
# the checkout root, as every path in a profile is.
FDT_HANDLER_PLAN=fdt-commons/examples/plan-gene-disease-single.jsonld

# The port this instance is served on.
FDT_TESTBED_PORT=8404
